<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<ItemGroup>
		<!-- Bluetooth: P/Invoke natywne (bthprops.cpl) w Program.cs — nie potrzeba InTheHand.Net.Bluetooth -->
		<!-- Włączanie/wyłączanie radia BT: Windows.Devices.Radios (wbudowane w SDK dzięki TargetFramework windows10.x) -->
		<PackageReference Include="System.IO.Ports" Version="10.0.8" />
	</ItemGroup>
</Project>